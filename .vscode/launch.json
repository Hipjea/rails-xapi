{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "rdbg",
      "name": "Debug Rails Server",
      "request": "launch",
      "script": "${workspaceFolder}/bin/rails",
      "args": [
        "server"
      ],
      "env": {
        "RUBY_DEBUG_OPEN": "true"
      },
      "useBundler": true
    },
    {
      "type": "rdbg",
      "name": "Attach rdbg",
      "request": "attach"
    }
  ]
}